# Supabase Dashboard > Project Settings > API
# 값을 채운 뒤 개발 서버를 다시 시작하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Datadog RUM & Logs
# Datadog Dashboard > Digital Experience > Add an Application (JavaScript)
# false로 두면 Datadog 연동을 완전히 끕니다.
VITE_DATADOG_ENABLED=true
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=datadoghq.com
VITE_DATADOG_SERVICE=ssen-ledger
VITE_DATADOG_ENV=development
VITE_DATADOG_VERSION=1.0.0
# 세션 리플레이(화면 녹화) 수집 비율. 개인정보 보호를 위해 기본 0.
VITE_DATADOG_REPLAY_SAMPLE_RATE=0
