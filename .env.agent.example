# Muse / Agent REST API용 환경변수 예시
# 실제 값은 .env.agent 또는 Supabase Edge Function Secrets에만 넣으세요.
# 이 파일은 프런트엔드(Vite)에서 읽지 않습니다.

# Muse가 Authorization: Bearer 로 보낼 단일 API 키
AGENT_API_KEY=

# 선택: 가구가 여러 개일 때 지정하는 가구 UUID
AGENT_HOUSEHOLD_ID=

# 배포 대상 Supabase 프로젝트 ref
SUPABASE_PROJECT_REF=

# 로컬 테스트 시에만 사용 (미지정 시 Deno 기본값)
AGENT_API_PORT=

# Supabase Edge Function에서는 자동 제공됩니다.
# 로컬 테스트/별도 서버에서 실행할 때만 채우세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
